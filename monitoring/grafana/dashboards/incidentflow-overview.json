{
  "uid": "incidentflow-overview",
  "title": "IncidentFlow Monitoring Overview",
  "tags": [
    "incidentflow",
    "fastapi",
    "prometheus"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API Availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "incidentflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "up{job=\"incidentflow-api\"}",
          "refId": "A",
          "legendFormat": "API Availability"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "incidentflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{handler!=\"/metrics\"}[5m]))",
          "refId": "A",
          "legendFormat": "HTTP Request Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "HTTP 5xx Error Rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "incidentflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "100 * sum(rate(http_requests_total{status=\"5xx\",handler!=\"/metrics\"}[5m])) or vector(0)",
          "refId": "A",
          "legendFormat": "HTTP 5xx Error Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Average Response Time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "incidentflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_sum{handler!=\"/metrics\"}[5m])) / clamp_min(sum(rate(http_request_duration_seconds_count{handler!=\"/metrics\"}[5m])),0.000001)",
          "refId": "A",
          "legendFormat": "Average Response Time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
